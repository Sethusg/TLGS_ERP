# TLGS-ERP Shared Environment Configuration (Web + Windows 11 Desktop)
# See config/profiles/ for profile-specific templates:
#   development | web-production | desktop-development | desktop-production | local-standalone

NODE_ENV=development
TLGS_PROFILE=development
TLGS_BACKEND_MODE=central-server
PORT=3000
TLGS_HOST=0.0.0.0
TLGS_TRUST_PROXY=false
TLGS_LOG_LEVEL=info
TLGS_DATA_DIR=.erp-data
TLGS_BACKUP_DIR=.erp-data/backups
TLGS_CORS_ORIGINS=

# Optional Frontend API Base URL (empty = same-origin)
VITE_API_BASE_URL=

# Optional Windows 11 Desktop Central Server URL (Mode A)
TLGS_REMOTE_SERVER_URL=

# Server-Only MySQL 8+ Configuration (NEVER exposed to React or Electron Renderer)
TLGS_DB_ENGINE=local-file
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tlgs_erp
MYSQL_USER=
MYSQL_PASSWORD=

# Server-Only Auth Session Secret (generate 64-char random hex in production)
ERP_SESSION_SECRET=
