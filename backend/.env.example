# LEADERS Multi-School ERP — Django + MySQL 8.0 Environment Configuration
# Copy this file to .env and populate real credentials before running migrations.
# Never commit .env with production secrets to version control.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Brand-new MySQL 8.0 Database (Never point to an existing/legacy ERP DB)
DB_NAME=leaders_multischool_erp
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend React + Vite origin allowlist (never use wildcard '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Lifetimes (minutes / days)
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
