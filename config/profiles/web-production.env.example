# Profile 2: Web Production (School LAN or HTTPS Cloud Server)
NODE_ENV=production
TLGS_PROFILE=web-production
TLGS_BACKEND_MODE=central-server
PORT=3000
TLGS_HOST=0.0.0.0
TLGS_TRUST_PROXY=true
TLGS_LOG_LEVEL=info
TLGS_CORS_ORIGINS=https://erp.yourschool.edu.in
TLGS_DATA_DIR=/var/lib/tlgs-erp/data
TLGS_BACKUP_DIR=/var/lib/tlgs-erp/backups
# Frontend builds against same-origin HTTPS or dedicated API URL
VITE_API_BASE_URL=
# Server-side only Production MySQL 8+ (never packaged into Electron/frontend)
TLGS_DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tlgs_erp_prod
MYSQL_USER=tlgs_erp_app
MYSQL_PASSWORD=
ERP_SESSION_SECRET=
