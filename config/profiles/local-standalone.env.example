# Profile 5: Local Standalone Mode (Windows 11 EXE -> Embedded Isolated Local Service)
NODE_ENV=production
TLGS_PROFILE=local-standalone
TLGS_BACKEND_MODE=local-standalone
TLGS_HOST=127.0.0.1
TLGS_LOG_LEVEL=info
# Stored strictly inside isolated %APPDATA%\TLGS-ERP\local-standalone-data (never touches shared production DB)
TLGS_DB_ENGINE=local-file
