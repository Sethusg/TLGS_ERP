# Profile 1: Development (Web + API local dev)
NODE_ENV=development
TLGS_PROFILE=development
TLGS_BACKEND_MODE=central-server
PORT=3000
TLGS_HOST=0.0.0.0
TLGS_LOG_LEVEL=debug
TLGS_DATA_DIR=.erp-data
TLGS_BACKUP_DIR=.erp-data/backups
# Optional frontend API override (leave empty for same-origin)
VITE_API_BASE_URL=
# Server-side only MySQL credentials (never prefixed with VITE_)
TLGS_DB_ENGINE=local-file
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tlgs_erp_dev
MYSQL_USER=
MYSQL_PASSWORD=
ERP_SESSION_SECRET=
